{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pdftodxf-api",
      "runtimeExecutable": ".venv\\Scripts\\python.exe",
      "runtimeArgs": ["-m", "uvicorn", "web.api.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "pdftodxf-web",
      "runtimeExecutable": "npm",
