# Copie para `.env` ao lado, preencha, e feche a permissão:
#   cp .env.exemplo .env && chmod 600 .env
# Este arquivo é modelo. O `.env` de verdade nunca entra no repositório.

# --- o que muda a cada publicação -------------------------------------------
# Trocada automaticamente por publicar.sh. Preencha uma vez, no primeiro deploy.
IMAGEM=

# --- endereço ---------------------------------------------------------------
# O domínio, sem esquema. Ex.: pdftodxf.com.br
DOMINIO=
# A URL completa, com https://. É o que os links dos e-mails usam.
PDFTODXF_URL_BASE=

# --- segredos ---------------------------------------------------------------
# Assina o cookie de sessão. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Trocar esta chave desloga todo mundo.
PDFTODXF_SEGREDO=

# --- e-mail (Brevo) ---------------------------------------------------------
PDFTODXF_SMTP_SERVIDOR=
PDFTODXF_SMTP_PORTA=
PDFTODXF_SMTP_USUARIO=
PDFTODXF_SMTP_SENHA=
PDFTODXF_SMTP_REMETENTE=

# --- backup -----------------------------------------------------------------
# O comando que leva a cópia para fora da VPS. Recebe o caminho do arquivo
# como último argumento. Ex.: rclone copy --config /etc/rclone.conf
PDFTODXF_BACKUP_COMANDO=
# Por quantos dias guardar as cópias locais antes de apagar.
PDFTODXF_BACKUP_DIAS=
